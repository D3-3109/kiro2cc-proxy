# The image only needs Cargo.toml, Cargo.lock, src/, assets/ and web-ui/.
# Cargo.lock must stay in the context: the build uses `cargo build --locked`.

# Rust build artifacts
target/

# Node.js dependencies and build artifacts (rebuilt inside the image)
web-ui/*/node_modules/
web-ui/*/dist/
web-ui/*/tsconfig.tsbuildinfo
web-ui/*/.vite/
.pnpm-store/

# Version control
.git/
.gitignore

# IDE and editor files
.idea/
.vscode/
*.swp
*.swo
*~

# Claude/AI
.claude/
.playwright-mcp/
CLAUDE.md
AGENTS.md

# CI/CD
.github/

# Documentation, specs and examples
docs/
openspec/
*.md
config.example.json
server.env.example
credentials.example.*.json

# Development scripts and tools
scripts/
tools/
*.sh
!docker-entrypoint.sh
*.ps1
test.json

# OS-specific files
.DS_Store
Thumbs.db

# Local configuration and runtime data
app/
config.json
credentials*.json
server.env
.env
logs/

# Docker and deployment files
Dockerfile
.dockerignore
docker-compose*.yml
fly.toml
kiro2cc-proxy.service
